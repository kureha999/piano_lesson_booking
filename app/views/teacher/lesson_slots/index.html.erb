<%# T-04 固定枠の一覧 %>
<% content_for :title, "固定枠 | ふりかえ帳" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">固定枠</h1>
  <%= link_to "固定枠を追加する", new_teacher_lesson_slot_path, class: "btn btn-primary" %>
</div>
<p class="text-body-secondary">今日（<%= japanese_date(Date.current) %>）に有効な、毎週のレッスンです。</p>

<% if @lesson_slots.empty? %>
  <p class="text-body-secondary">まだ固定枠が登録されていません。</p>
<% else %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th scope="col">曜日</th>
          <th scope="col">時間</th>
          <th scope="col">生徒</th>
          <th scope="col">適用期間</th>
          <th scope="col"><span class="visually-hidden">操作</span></th>
        </tr>
      </thead>
      <tbody>
        <% @lesson_slots.each do |slot| %>
          <tr>
            <td><%= slot.wday_name %></td>
            <td><%= slot.time_range %></td>
            <td><%= slot.student.name %></td>
            <td>
              <%= japanese_date(slot.starts_on) %>から
              <%= slot.ends_on ? "#{japanese_date(slot.ends_on)}まで" : "（終了日なし）" %>
            </td>
            <td class="text-end"><%= link_to "変更", edit_teacher_lesson_slot_path(slot), aria: { label: "#{slot.student.name}さんの#{slot.wday_name}#{slot.time_range}の枠を変更" } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
