<%# T-02 生徒一覧。生徒ごとに、今月の振替の利用回数（その月に振替権が付いた欠席の数）を表示する %>
<% content_for :title, "生徒一覧 | ふりかえ帳" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">生徒一覧</h1>
  <%= link_to "生徒を追加する", new_teacher_student_path, class: "btn btn-primary" %>
</div>

<% if @students.empty? %>
  <p class="text-body-secondary">まだ生徒が登録されていません。</p>
<% else %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th scope="col">生徒</th>
          <th scope="col">保護者</th>
          <th scope="col">今月の振替の利用回数</th>
          <th scope="col"><span class="visually-hidden">操作</span></th>
        </tr>
      </thead>
      <tbody>
        <% @students.each do |student| %>
          <tr>
            <td><%= student.name %></td>
            <td><%= student.guardian.name %></td>
            <td><%= @usage_counts.fetch(student.id, 0) %>回 <span class="text-body-secondary">（上限 <%= @monthly_limit %>回）</span></td>
            <td class="text-end"><%= link_to "編集", edit_teacher_student_path(student), aria: { label: "#{student.name}さんを編集" } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
