<%# T-03 生徒の登録・編集のフォーム。form は StudentForm、url と method は呼び出し側で渡す %>
<%= form_with(model: form, url: url, method: method) do |f| %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, autofocus: true, class: "form-control" %>
    <%= field_error(form, :name) %>
  </div>

  <h2 class="h6 mt-4">保護者</h2>
  <% if form.persisted? %>
    <p class="form-text">名前やメールアドレスを変えると、この保護者のすべての生徒に反映されます。</p>
  <% else %>
    <p class="form-text">登録済みのメールアドレスの場合は、その保護者に生徒を追加します（兄弟は1つのアカウントにまとめます）。</p>
  <% end %>

  <div class="mb-3">
    <%= f.label :guardian_email, class: "form-label" %>
    <%= f.email_field :guardian_email, autocomplete: "off", class: "form-control" %>
    <%= field_error(form, :guardian_email) %>
  </div>

  <div class="mb-3">
    <%= f.label :guardian_name, class: "form-label" %>
    <%= f.text_field :guardian_name, autocomplete: "off", class: "form-control" %>
    <%= field_error(form, :guardian_name) %>
  </div>

  <div class="d-grid gap-2 d-md-flex">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "一覧に戻る", teacher_students_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
