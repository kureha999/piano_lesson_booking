<%# T-06 振替枠の一覧。予約数は、キャンセル済みを数えずに「予約数 / 定員」で表示する %>
<% content_for :title, "振替枠 | ふりかえ帳" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">振替枠</h1>
  <%= link_to "振替枠を追加する", new_teacher_makeup_slot_path, class: "btn btn-primary" %>
</div>
<p class="text-body-secondary">これから受け付ける振替枠です。</p>

<% if @makeup_slots.empty? %>
  <p class="text-body-secondary">これからの振替枠はありません。</p>
<% else %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th scope="col">日付</th>
          <th scope="col">時間</th>
          <th scope="col">定員</th>
          <th scope="col">予約数</th>
          <th scope="col"><span class="visually-hidden">操作</span></th>
        </tr>
      </thead>
      <tbody>
        <% @makeup_slots.each do |slot| %>
          <tr>
            <td><%= japanese_date(slot.starts_at) %>（<%= I18n.t("date.abbr_day_names")[slot.starts_at.wday] %>）</td>
            <td><%= slot.starts_at.strftime("%H:%M") %>〜<%= slot.ends_at.strftime("%H:%M") %></td>
            <td><%= slot.capacity %>人</td>
            <%# 予約数は、キャンセル済みを数えず、定員と並べて「予約数 / 定員」の形で表示する %>
            <td><%= slot.reserved_count %> / <%= slot.capacity %></td>
            <td class="text-end"><%= link_to "編集", edit_teacher_makeup_slot_path(slot), aria: { label: "#{slot.period_text}の振替枠を編集" } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
