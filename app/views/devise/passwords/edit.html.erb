<%# C-04 新しいパスワードの入力。再設定メールのリンクから開く %>
<% content_for :title, "新しいパスワード | ふりかえ帳" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <h1 class="h4 mb-3">新しいパスワードの入力</h1>

    <%= form_with(model: resource, scope: resource_name, url: password_path(resource_name), method: :put) do |f| %>
      <%= f.hidden_field :reset_password_token, autocomplete: "off" %>
      <%# リンクの期限切れなど、トークンのエラーはフォームの上に表示する %>
      <%= field_error(resource, :reset_password_token) %>

      <div class="mb-3">
        <%= f.label :password, "新しいパスワード", class: "form-label" %>
        <% if @minimum_password_length %>
          <div class="form-text"><%= @minimum_password_length %>文字以上で入力してください</div>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
        <%= field_error(resource, :password) %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        <%= field_error(resource, :password_confirmation) %>
      </div>

      <%= f.submit "変更する", class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>
