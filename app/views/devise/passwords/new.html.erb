<%# C-03 パスワード再設定の申請 %>
<% content_for :title, "パスワードの再設定 | ふりかえ帳" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <h1 class="h4 mb-3">パスワードの再設定</h1>
    <p>登録しているメールアドレスを入力してください。パスワードを再設定するためのメールをお送りします。</p>

    <%= form_with(model: resource, scope: resource_name, url: password_path(resource_name), method: :post) do |f| %>
      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        <%= field_error(resource, :email) %>
      </div>

      <%= f.submit "送信する", class: "btn btn-primary w-100" %>
    <% end %>

    <p class="mt-3 text-center"><%= link_to "ログイン画面に戻る", new_session_path(resource_name) %></p>
  </div>
</div>
