<%# C-02 パスワード設定。招待メールのリンクから開く %>
<% content_for :title, "パスワードの設定 | ふりかえ帳" %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-5">
    <h1 class="h4 mb-3">パスワードの設定</h1>
    <p class="text-muted"><%= resource.name %>さん、ふりかえ帳へようこそ。ログインに使うパスワードを決めてください。</p>

    <%= form_with(model: resource, scope: resource_name, url: invitation_path(resource_name), method: :put) do |f| %>
      <%= f.hidden_field :invitation_token, readonly: true %>

      <div class="mb-3">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, value: resource.email, disabled: true, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "パスワード", class: "form-label" %>
        <% if @minimum_password_length %>
          <div class="form-text"><%= @minimum_password_length %>文字以上で入力してください</div>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
        <%= field_error(resource, :password) %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        <%= field_error(resource, :password_confirmation) %>
      </div>

      <%= f.submit "設定する", class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>
