<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "ふりかえ帳" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ふりかえ帳">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Bootstrap（vendor/assets/stylesheets）→ アプリ独自の CSS（app/assets/stylesheets）の順に読み込む %>
    <%= stylesheet_link_tag "bootstrap.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# ログイン中は、ロールに合わせたメニューを出す。画面が content_for(:menu) で渡した場合はそちらを優先する %>
    <% content_for(:menu, render("shared/menu")) if user_signed_in? && !content_for?(:menu) %>
    <%= render "shared/header" %>

    <main class="container py-3">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
