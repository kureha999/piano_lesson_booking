# 環境変数の一覧。このファイルをコピーして .env を作る（cp .env.example .env）。
# .env は Git に入れない。実際の値（パスワード・API キーなど）は .env にだけ書く。
# 空の .env でも起動できる。変えたい値だけ、行頭の # を外して書く。
#
# 分け方：
#   環境変数（このファイル）：環境ごとに変わる値（ポート、スレッド数など）
#   Rails の credentials：本番の秘密情報（API キー、メールの認証情報など）
#   ※ 本番の環境変数は、デプロイ先（M7 の AWS）で設定する。.env は本番では使わない。

# Puma（開発サーバー）が待ち受けるポート。省略すると 3000
# PORT=3000

# Puma のスレッド数と、DB の接続数の上限。省略すると Puma は 3、DB は 5
# RAILS_MAX_THREADS=3

# 本番のログの詳細さ（debug / info / warn / error）。省略すると info
# RAILS_LOG_LEVEL=info
